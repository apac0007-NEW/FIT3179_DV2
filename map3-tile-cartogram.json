{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "A tile map compares festival counts fairly",
    "subtitle": "Each state/territory receives one tile; darker tiles represent more mapped music festivals in 2022–23."
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "domain": false,
      "tickSize": 0,
      "labelFontSize": 11,
      "titleFontSize": 11,
      "gridColor": "#e8e5df"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "title": {
      "font": "Bricolage Grotesque",
      "fontSize": 17,
      "anchor": "start",
      "subtitleFont": "Source Sans 3",
      "subtitleColor": "#59645e"
    }
  },
  "width": 550,
  "height": 320,
  "data": {
    "url": "data/states.json"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 6,
        "stroke": "#fff",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "tileX",
          "type": "ordinal",
          "axis": null,
          "sort": [
            0,
            1,
            2,
            3,
            4
          ]
        },
        "y": {
          "field": "tileY",
          "type": "ordinal",
          "axis": null,
          "sort": [
            0,
            1,
            2,
            3,
            4
          ]
        },
        "color": {
          "field": "musicFestivals",
          "type": "quantitative",
          "title": "Mapped music festivals",
          "scale": {
            "scheme": "tealblues",
            "domain": [
              0,
              150
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "musicFestivals",
            "type": "quantitative",
            "title": "Mapped music festivals"
          },
          {
            "field": "festivalsPer10k",
            "type": "quantitative",
            "title": "Festivals per 10,000 residents"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "tileX",
          "type": "ordinal",
          "sort": [
            0,
            1,
            2,
            3
          ]
        },
        "y": {
          "field": "tileY",
          "type": "ordinal",
          "sort": [
            0,
            1,
            2,
            3,
            4
          ]
        },
        "text": {
          "field": "abbr",
          "type": "nominal"
        },
        "color": {
          "field": "musicFestivals",
          "type": "quantitative",
          "title": "Mapped music festivals",
          "scale": {
            "scheme": "tealblues",
            "domain": [
              0,
              150
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "musicFestivals",
            "type": "quantitative",
            "title": "Mapped music festivals"
          },
          {
            "field": "festivalsPer10k",
            "type": "quantitative",
            "title": "Festivals per 10,000 residents"
          }
        ]
      }
    }
  ]
}