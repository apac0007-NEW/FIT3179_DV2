{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Cultural festivals create space for identity and recognition",
    "subtitle": "Latest 2025 national survey results: cultural participation, attendance at First Nations arts/festivals and attitudes. Measures differ."
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Source Sans 3",
    "axis": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3",
      "domain": false,
      "tickSize": 0,
      "labelFontSize": 11,
      "titleFontSize": 11,
      "gridColor": "#e8e5df"
    },
    "legend": {
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    },
    "title": {
      "font": "Bricolage Grotesque",
      "fontSize": 17,
      "anchor": "start",
      "subtitleFont": "Source Sans 3",
      "subtitleColor": "#59645e"
    }
  },
  "width": 600,
  "height": 220,
  "data": {
    "url": "data/cultural_festivals.json"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "y": {
      "field": "measure",
      "type": "nominal",
      "title": null
    },
    "x": {
      "field": "rate",
      "type": "quantitative",
      "title": "Australians (%)",
      "scale": {
        "domain": [
          0,
          80
        ]
      }
    },
    "color": {
      "value": "#167c72"
    },
    "tooltip": [
      {
        "field": "measure",
        "type": "nominal"
      },
      {
        "field": "rate",
        "type": "quantitative",
        "title": "Respondents (%)"
      },
      {
        "field": "year",
        "type": "nominal"
      }
    ]
  }
}